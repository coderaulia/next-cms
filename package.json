{
  "name": "react-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "analyze": "node scripts/run-build-analyze.mjs",
    "audit:src": "node scripts/report-src-sizes.mjs",
    "audit:size": "node scripts/report-build-sizes.mjs",
    "build:audit": "npm run build && npm run audit:size",
    "start": "next start",
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:deploy": "npm run check && npm run build && npm run audit:size",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:purge": "tsx scripts/purge-supabase.ts",
    "db:reset": "tsx scripts/reset-supabase.ts",
    "db:seed:file": "tsx scripts/import-content.ts",
    "db:seed:blog": "tsx scripts/seed-blog-posts.ts",
    "db:reseed": "npm run db:reset -- --force && npm run db:migrate && npm run db:seed:file",
    "bootstrap:client": "tsx scripts/bootstrap-client.ts",
    "media:migrate:supabase": "tsx scripts/migrate-media-to-supabase.ts",
    "media:migrate:supabase:dry": "tsx scripts/migrate-media-to-supabase.ts --dry-run",
    "db:enable-rls": "tsx scripts/enable-rls.ts",
    "db:enable-rls:dry": "tsx scripts/enable-rls.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@floating-ui/dom": "^1.7.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^3.4.19",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.4.3",
    "@next/eslint-plugin-next": "^16.4.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.23.4 <23.0.0 || >=24.22.1 <25.0.0 || >=26.12.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "postcss-selector-parser": "^7.1.7"
  }
}
